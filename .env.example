# Passive Array — Environment Variables Example
# Copy to .env.local for local testing or configure in Vercel Project Settings.
# Never commit real secrets to git.

# ------------------------------------------------------------------ Polar Billing (polar.sh)
# "production" (default) or "sandbox" (for sandbox.polar.sh testing)
POLAR_ENV=production

# Organization Access Token from Polar (Settings > Developers > Tokens -> polar_oat_...)
POLAR_ACCESS_TOKEN=polar_oat_...

# Polar Product IDs (UUIDs) for Passive Array Pro ($9/mo, $79/yr)
POLAR_PRODUCT_ID_MONTHLY=
POLAR_PRODUCT_ID_YEARLY=

# Webhook Endpoint signing secret from Polar (Settings > Webhooks -> https://passivearray.com/api/billing-webhook)
POLAR_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------ Site & Data APIs
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
ANTHROPIC_API_KEY=
SESSION_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Lifetime plan (optional). Two one-time products in Polar: the regular price ($149) and the
# launch price ($99) that is offered until 100 lifetime orders are paid.
POLAR_PRODUCT_ID_LIFETIME=
POLAR_PRODUCT_ID_LIFETIME_LAUNCH=
