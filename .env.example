# Passive Array — Live Environment Variables Example
# Copy to .env.local for local testing or configure in Vercel Project Settings.
# Never commit real secrets to git.

# ------------------------------------------------------------------ Paddle Billing (Live)
# Server-side live API key (Settings > Authentication)
# Required permissions: customer_portal_session.write, transaction.write, subscription.read, customer.read
PADDLE_API_KEY=pdl_live_apikey_...

# Client-side live token for Paddle.js overlay checkout (Settings > Authentication > Client-side tokens)
PADDLE_CLIENT_TOKEN=live_...

# Live catalog Price IDs for Passive Array Pro ($9/mo, $79/yr)
PADDLE_PRICE_ID_MONTHLY=pri_01...
PADDLE_PRICE_ID_YEARLY=pri_01...

# Live Notification Destination signing secret (Events > Notifications -> https://passivearray.com/api/billing-webhook)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# Enforce dynamic IP allowlisting against https://api.paddle.com/ips (default: enabled; set 0 only for local tests)
PADDLE_ENFORCE_IP_ALLOWLIST=1

# ------------------------------------------------------------------ Site & Data APIs
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
ANTHROPIC_API_KEY=
SESSION_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
