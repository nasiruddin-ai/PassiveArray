{
  "manifest_version": 3,
  "name": "Passive Array for YouTube",
  "version": "1.2.0",
  "description": "Engagement rate, monetization check, hidden tags, tag suggestions in Studio, views per day, channel insights and search scores, right on YouTube. Free.",
  "homepage_url": "https://passivearray.com/youtube-extension/",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "192": "icons/icon-192.png"
  },
  "action": {
    "default_title": "Passive Array for YouTube",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://passivearray.com/*",
    "https://www.youtube.com/*",
    "https://suggestqueries.google.com/*",
    "https://studio.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/mark.svg",
        "icons/icon-48.png"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "studio.js"
      ],
      "css": [
        "content.css",
        "studio.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
