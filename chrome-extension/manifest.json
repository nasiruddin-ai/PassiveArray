{
  "manifest_version": 3,
  "name": "Passive Array for YouTube",
  "version": "1.0.0",
  "description": "Engagement rate, hidden tags, views per day, channel insights, search scores and a keyword tool, right on YouTube. Free.",
  "homepage_url": "https://passivearray.vercel.app/youtube-extension/",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "192": "icons/icon-192.png"
  },
  "action": {
    "default_title": "Passive Array for YouTube",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://passivearray.vercel.app/*",
    "https://www.youtube.com/*",
    "https://suggestqueries.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/mark.svg", "icons/icon-48.png"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
