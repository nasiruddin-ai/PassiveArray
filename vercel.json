{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/creator-tools/api/youtube",
      "destination": "/api/creator-youtube"
    },
    {
      "source": "/creator-tools/api/twitch",
      "destination": "/api/creator-twitch"
    },
    {
      "source": "/creator-tools/api/ai",
      "destination": "/api/creator-ai"
    },
    {
      "source": "/research/api/:action",
      "destination": "/api/research?action=:action"
    },
    {
      "source": "/api/watch",
      "destination": "/api/pro?fn=watch"
    },
    {
      "source": "/api/watch-cron",
      "destination": "/api/pro?fn=watch-cron"
    },
    {
      "source": "/api/billing",
      "destination": "/api/pro?fn=billing"
    },
    {
      "source": "/api/billing-webhook",
      "destination": "/api/pro?fn=billing-webhook"
    },
    {
      "source": "/api/channel",
      "destination": "/api/pro?fn=channel"
    }
  ],
  "headers": [
    {
      "source": "/creator-tools/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/research-cron",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/watch-cron",
      "schedule": "45 5 * * *"
    }
  ],
  "functions": {
    "api/research-cron.js": {
      "maxDuration": 60
    },
    "api/creator-youtube.js": {
      "maxDuration": 30
    },
    "api/pro.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/|creator-tools/api/|research/api/).*)",
      "has": [
        {
          "type": "host",
          "value": "passivearray.vercel.app"
        }
      ],
      "destination": "https://passivearray.com/:path",
      "statusCode": 301
    },
    {
      "source": "/creator-tools/:tool/privacy{/}?",
      "destination": "/privacy/",
      "statusCode": 301
    },
    {
      "source": "/creator-tools/:tool/terms{/}?",
      "destination": "/terms/",
      "statusCode": 301
    },
    {
      "source": "/(blog|compare|research)/:slug/:page(privacy|terms){/}?",
      "destination": "/:page/",
      "statusCode": 301
    },
    {
      "source": "/:tool(meta-tag-checker|serp-snippet-preview|schema-markup-generator|domain-finder|domain-age-checker|plagiarism-checker|jpg-to-pdf|seo-roi-calculator)/:rest*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:tool(meta-tag-checker|serp-snippet-preview|schema-markup-generator|domain-finder|domain-age-checker|plagiarism-checker|jpg-to-pdf|seo-roi-calculator)",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
