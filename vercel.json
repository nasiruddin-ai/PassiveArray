{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/creator-tools/api/youtube",
      "destination": "/api/creator-youtube"
    },
    {
      "source": "/creator-tools/api/twitch",
      "destination": "/api/creator-twitch"
    },
    {
      "source": "/creator-tools/api/ai",
      "destination": "/api/creator-ai"
    },
    {
      "source": "/domain-age-checker/api/age",
      "destination": "/api/domain-age"
    },
    {
      "source": "/domain-finder/api/check",
      "destination": "/api/domain-finder-check"
    },
    {
      "source": "/plagiarism-checker/api/:action",
      "destination": "/api/plagiarism?action=:action"
    },
    {
      "source": "/research/api/:action",
      "destination": "/api/research?action=:action"
    },
    {
      "source": "/api/watch",
      "destination": "/api/pro?fn=watch"
    },
    {
      "source": "/api/watch-cron",
      "destination": "/api/pro?fn=watch-cron"
    },
    {
      "source": "/api/billing",
      "destination": "/api/pro?fn=billing"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/pro?fn=stripe-webhook"
    },
    {
      "source": "/api/channel",
      "destination": "/api/pro?fn=channel"
    }
  ],
  "headers": [
    {
      "source": "/creator-tools/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|favicon\\.ico|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|og-image-1200x630\\.png|founder-nasir\\.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/research-cron",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/watch-cron",
      "schedule": "45 5 * * *"
    }
  ],
  "functions": {
    "api/research-cron.js": {
      "maxDuration": 60
    },
    "api/creator-youtube.js": {
      "maxDuration": 30
    },
    "api/pro.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/|creator-tools/api/|research/api/|plagiarism-checker/api/|domain-age-checker/api/|domain-finder/api/).*)",
      "has": [
        {
          "type": "host",
          "value": "passivearray.vercel.app"
        }
      ],
      "destination": "https://passivearray.com/:path",
      "statusCode": 301
    }
  ]
}
